+)
+
+var (
+	ctx         = context.Background()
+	td          = spiffeid.RequireTrustDomainFromString("example.org")
+	federatedTd = spiffeid.RequireTrustDomainFromString("domain1.org")
+)
+
+func TestGetFederationRelationship(t *testing.T) {
