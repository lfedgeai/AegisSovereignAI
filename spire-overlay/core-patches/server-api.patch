+type serviceTest struct {
+	client      bundlev1.BundleClient
+	ds          *fakedatastore.DataStore
+	logHook     *test.Hook
+	up          *fakeUpstreamPublisher
+	rateLimiter *fakeRateLimiter
+	done        func()
