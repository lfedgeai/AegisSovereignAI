+		},
+		{
+			name:              "all bundles at once with most permissive mask",
+			expectBundlePages: [][]*common.Bundle{{b1, b2, b3}},
+			outputMask: &types.BundleMask{
+				RefreshHint:     true,
+				SequenceNumber:  true,
+				X509Authorities: true,
+				JwtAuthorities:  true,
+			},
+			expectLogs: [][]spiretest.LogEntry{
